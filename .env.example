# Vishap - environment variables
# Docs: https://github.com/dvddv9/vishap

# === LLM Provider selection (v5.10.1) ===
# auto | deepseek | openai | custom | ollama
#   auto    -> auto-detect by env (custom -> openai -> deepseek -> ollama)
#   deepseek -> DeepSeek API (cloud)
#   openai  -> OpenAI API (or any OpenAI-compatible endpoint)
#   custom  -> custom OpenAI-compatible endpoint (Groq, LM Studio, vLLM, ...)
#   ollama  -> local Ollama server
VISHAP_LLM_PROVIDER=auto

# === DeepSeek API (cloud, recommended) ===
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# === OpenAI (or any OpenAI-compatible endpoint) ===
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# === Custom OpenAI-compatible (Groq, Together, Fireworks, OpenRouter, LM Studio, vLLM, ...) ===
# Example 1: Groq (fast, free tier)
#   CUSTOM_API_KEY=gsk_...
#   CUSTOM_BASE_URL=https://api.groq.com/openai/v1
#   CUSTOM_MODEL=llama-3.3-70b-versatile
#
# Example 2: LM Studio (local, GUI)
#   CUSTOM_API_KEY=not-needed
#   CUSTOM_BASE_URL=http://localhost:1234/v1
#   CUSTOM_MODEL=local-model
#
# Example 3: vLLM (local, server)
#   CUSTOM_API_KEY=not-needed
#   CUSTOM_BASE_URL=http://localhost:8000/v1
#   CUSTOM_MODEL=meta-llama/Llama-3.1-8B-Instruct
#
# Example 4: OpenRouter (aggregator)
#   CUSTOM_API_KEY=sk-or-...
#   CUSTOM_BASE_URL=https://openrouter.ai/api/v1
#   CUSTOM_MODEL=anthropic/claude-3.5-sonnet
#
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
# CUSTOM_BASE_URL=

# === Ollama (local fallback) ===
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# === Server ===
PORT=5001
API_URL=http://localhost:5001
CONVEYOR_API_KEY=

# === Tavily Web Search (optional, for fresh CVEs and patches) ===
TAVILY_API_KEY=tvly-your-tavily-key-here
ENABLE_WEB_SEARCH=false
SEARCH_MAX_RESULTS=5
SEARCH_DEPTH=basic

# === PostgreSQL (для JOB_STORE=postgres) ===
DATABASE_URL=postgresql+asyncpg://vishap:vishap_dev@localhost:5432/vishap
POSTGRES_PASSWORD=vishap_dev

# === Logging (structlog, v6.1) ===
LOG_LEVEL=INFO
LOG_FORMAT=pretty

# === Security (Fernet, v6.1) ===
FERNET_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
